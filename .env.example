# Copy to .env (git-ignored) and fill in. Loaded by `orch` at startup;
# variables already set in your environment take precedence.
#   cp .env.example .env && chmod 600 .env

# OpenAI backend (config/llm.openai-hybrid.yaml)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic backend (config/llm.anthropic.yaml) — or use `ant auth login`
# ANTHROPIC_API_KEY=
